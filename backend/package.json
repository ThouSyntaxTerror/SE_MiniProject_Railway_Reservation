{
  "name": "rrs-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "test": "jest --runInBand",
    "seed:perf": "node scripts/seedPerformance.js",
    "test:load": "node scripts/loadTest.js",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testTimeout": 20000,
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "coverageProvider": "v8",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov"
    ],
    "coverageDirectory": "coverage"
  }
}
